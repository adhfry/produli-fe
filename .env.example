# Base URL API backend PRODULI (lihat docs/planning/05-kontrak-api-produli-backend.md)
# Dev:  http://localhost:8033/api/v1
# Prod: https://api.produli.labkesdasumenep.id/api/v1 (TODO(infra): domain belum di-provision)
NUXT_PUBLIC_API_BASE=http://localhost:8033/api/v1

# Site URL untuk @nuxtjs/sitemap — hanya dipakai halaman publik (landing/about)
NUXT_PUBLIC_SITE_URL=http://localhost:3033

# Tile server sendiri (self-hosted, TileServer GL/OpenMapTiles) untuk semua peta MapLibre GL --
# BUKAN CARTO/Google (raw tile Google melanggar ToS, CARTO free basemap tidak untuk bulk/offline
# caching, docs/planning/10 §5). Style penuh (sources+sprite+glyphs) di {url}/styles/basemap/style.json
NUXT_PUBLIC_TILE_SERVER_URL=https://tiles.labkesdasumenep.cloud

# Firebase Cloud Messaging (push notification) — config client-side publik Firebase (AMAN
# di-commit/expose, bukan rahasia), ambil dari Firebase Console > Project Settings > General >
# Your apps > Web app. NUXT_PUBLIC_FIREBASE_VAPID_KEY dari Project Settings > Cloud Messaging >
# Web Push certificates.
NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NUXT_PUBLIC_FIREBASE_PROJECT_ID=
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=
NUXT_PUBLIC_FIREBASE_VAPID_KEY=
